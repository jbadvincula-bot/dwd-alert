APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Billing Module Database (separate connection)
BILLING_DB_HOST=127.0.0.1
BILLING_DB_PORT=3306
BILLING_DB_DATABASE=billing
BILLING_DB_USERNAME=billing_user
BILLING_DB_PASSWORD=
BILLING_DB_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN=null                    # Local dev (browser default)
# SESSION_DOMAIN=.yourdomain.com         # Production — leading dot allows subdomains
# SESSION_SECURE_COOKIE=true             # Production — HTTPS only
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_TARGET_VIDEO_SIZE_MB=30
FFMPEG_BINARY_PATH=ffmpeg

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# IPROG SMS Configuration
IPROGSMS_API_URL=https://www.iprogsms.com/api/
IPROGSMS_API_TOKEN=
IPROGSMS_SENDER_ID=DasmariñasWD
IPROGSMS_ENABLED=false
IPROGSMS_TEST_MODE=false
IPROGSMS_TEST_NUMBERS=
IPROGSMS_RATE_LIMIT_PER_MINUTE=10
IPROGSMS_RATE_LIMIT_PER_HOUR=100
IPROGSMS_RATE_LIMIT_PER_DAY=500
IPROGSMS_MAX_MESSAGE_LENGTH=480

VITE_APP_NAME="${APP_NAME}"

# Google OAuth2 Configuration
# GOOGLE_REDIRECT_URI defaults to ${APP_URL}/resident/auth/google/callback if not set.
# Ensure this exact URI is registered in Google Cloud Console > Credentials > OAuth 2.0 Client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/resident/auth/google/callback"
